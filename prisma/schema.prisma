// ESNAF TEDARİK — veritabanı şeması
// Para alanları Decimal(12,2); kayan nokta kullanılmaz.
// Tüm ana kayıtlar Chamber (Oda) üzerinden çoklu Oda'ya hazırdır.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enum'lar ─────────────────────────

enum UserStatus {
  ACTIVE
  PASSIVE
  LOCKED
}

enum RoleScope {
  PLATFORM
  CHAMBER
  SUPPLIER
  MEMBER
}

enum SupplierStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum MemberStatus {
  PENDING
  ACTIVE
  PASSIVE
  REJECTED
}

enum DueStatus {
  UNPAID
  PAID
  WAIVED
}

enum ProductStatus {
  PENDING
  ACTIVE
  REJECTED
  ARCHIVED
}

enum UnitType {
  ADET
  KG
  LITRE
  PAKET
}

enum PackType {
  ADET
  KOLI
  KG
  PAKET
}

enum PriceType {
  LIST
  CHAMBER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StockReason {
  MANUAL
  ORDER
  ORDER_CANCEL
  ORDER_REJECT
}

enum CampaignType {
  CHAMBER_SPECIAL
  VOLUME
  DATE_RANGE
}

enum CampaignStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ENDED
}

enum DiscountKind {
  FIXED_PRICE
  PERCENT
  AMOUNT
}

enum SupplierOrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  REJECTED
  CANCELLED
}

enum InvoiceType {
  INVOICE
  WAYBILL
}

enum PaymentMethod {
  OFFLINE
}

enum PaymentStatus {
  PENDING
  RECORDED
}

enum PackageType {
  SHOWCASE
  PROMOTION
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum AdStatus {
  PENDING
  APPROVED
  REJECTED
  ENDED
}

enum AnnouncementAudience {
  ALL
  MEMBERS
  SUPPLIERS
  STAFF
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum DeliveryState {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum LegalDocType {
  KVKK
  TERMS
  SUPPLIER_AGREEMENT
  COOKIE
}

// ───────────────────────── Oda ─────────────────────────

model Chamber {
  id        String   @id @default(cuid())
  name      String
  shortName String
  city      String
  taxOffice String?
  taxNumber String?
  phone     String?
  email     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  members           Member[]
  supplierChambers  SupplierChamber[]
  categories        Category[]
  announcements     Announcement[]
  settings          Setting[]
  districts         District[]
  legalDocuments    LegalDocument[]
  products          Product[]
  orders            Order[]
  campaigns         Campaign[]
  adSlots           AdSlot[]
  supplierPackages  SupplierPackage[]
  productRequests   ProductRequest[]
  membershipDues    MembershipDue[]
}

model Setting {
  id        String   @id @default(cuid())
  chamberId String
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  chamber Chamber @relation(fields: [chamberId], references: [id], onDelete: Cascade)

  @@unique([chamberId, key])
}

model District {
  id           String  @id @default(cuid())
  chamberId    String
  city         String
  name         String
  active       Boolean @default(true)

  chamber       Chamber        @relation(fields: [chamberId], references: [id], onDelete: Cascade)
  deliveryAreas DeliveryArea[]
  addresses     Address[]

  @@unique([chamberId, city, name])
}

// ───────────────────────── Kimlik ve yetki ─────────────────────────

model User {
  id                 String     @id @default(cuid())
  chamberId          String?
  username           String     @unique
  email              String?    @unique
  phone              String?
  fullName           String
  passwordHash       String
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(true)
  failedLoginCount   Int        @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  chamber             Chamber?             @relation(fields: [chamberId], references: [id])
  roles               UserRole[]
  permissions         UserPermission[]
  sessions            Session[]
  resetTokens         PasswordResetToken[]
  supplierUser        SupplierUser?
  memberUser          MemberUser?
  notifications       Notification[]
  auditLogs           AuditLog[]
  consents            ConsentRecord[]
  orderStatusChanges  OrderStatusHistory[]
  createdOrders       Order[]              @relation("OrderCreatedBy")
  recordedDues        MembershipDue[]      @relation("DueRecordedBy")
}

model Role {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  scope       RoleScope
  description String?
  system      Boolean   @default(true)

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String @id @default(cuid())
  code        String @unique
  description String
  group       String

  roles RolePermission[]
  users UserPermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

/// Kişiye özel izin: granted=true ekler, false rolden gelen izni kaldırır.
model UserPermission {
  userId       String
  permissionId String
  granted      Boolean @default(true)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  ip         String?
  userAgent  String?
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  username  String
  ip        String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([username, createdAt])
}

// ───────────────────────── Tedarikçi ─────────────────────────

model Supplier {
  id             String         @id @default(cuid())
  legalName      String
  tradeName      String
  slug           String         @unique
  logoPath       String?
  description    String?
  taxOffice      String
  taxNumber      String         @unique
  mersisNumber   String?
  address        String
  phone          String
  email          String
  contactName    String
  contactPhone   String?
  minOrderAmount Decimal        @default(0) @db.Decimal(12, 2)
  status         SupplierStatus @default(PENDING)
  statusNote     String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  chambers         SupplierChamber[]
  users            SupplierUser[]
  deliveryAreas    DeliveryArea[]
  products         SupplierProduct[]
  supplierOrders   SupplierOrder[]
  campaigns        Campaign[]
  productRequests  ProductRequest[]
  subscriptions    SupplierSubscription[]
  advertisements   Advertisement[]
  catalogs         Catalog[]
}

model SupplierChamber {
  supplierId String
  chamberId  String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  chamber  Chamber  @relation(fields: [chamberId], references: [id], onDelete: Cascade)

  @@id([supplierId, chamberId])
}

model SupplierUser {
  userId     String  @id
  supplierId String
  title      String?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

/// deliveryDays: 1=Pazartesi … 7=Pazar
model DeliveryArea {
  id             String   @id @default(cuid())
  supplierId     String
  districtId     String
  deliveryDays   Int[]
  minOrderAmount Decimal? @db.Decimal(12, 2)

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  district District @relation(fields: [districtId], references: [id])

  @@unique([supplierId, districtId])
}

// ───────────────────────── Üye ─────────────────────────

model Member {
  id                String       @id @default(cuid())
  chamberId         String
  businessName      String
  ownerName         String
  registryNumber    String
  businessType      String?
  taxOffice         String?
  /// VKN/TCKN — uygulama katmanında şifreli saklanır
  taxIdEncrypted    String?
  phone             String
  email             String?
  status            MemberStatus @default(PENDING)
  statusNote        String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  chamber   Chamber         @relation(fields: [chamberId], references: [id])
  users     MemberUser[]
  addresses Address[]
  dues      MembershipDue[]
  cart      Cart?
  orders    Order[]
  favorites Favorite[]

  @@unique([chamberId, registryNumber])
}

model MemberUser {
  userId   String @id
  memberId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

model Address {
  id           String  @id @default(cuid())
  memberId     String
  title        String
  districtId   String
  neighborhood String?
  line         String
  isDefault    Boolean @default(false)

  member   Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  district District @relation(fields: [districtId], references: [id])
}

/// Aidat takibi. Tahsilat sistem dışında yapılır; burada yalnızca kayıt tutulur.
model MembershipDue {
  id           String    @id @default(cuid())
  chamberId    String
  memberId     String
  period       String // YYYY-MM
  amount       Decimal   @db.Decimal(12, 2)
  dueDate      DateTime
  paidAt       DateTime?
  status       DueStatus @default(UNPAID)
  note         String?
  recordedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  chamber    Chamber @relation(fields: [chamberId], references: [id])
  member     Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("DueRecordedBy", fields: [recordedById], references: [id])

  @@unique([memberId, period])
}

// ───────────────────────── Katalog ─────────────────────────

model Category {
  id        String   @id @default(cuid())
  chamberId String
  parentId  String?
  name      String
  slug      String
  sortOrder Int      @default(0)
  icon      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chamber  Chamber    @relation(fields: [chamberId], references: [id])
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
  catalogs Catalog[]

  @@unique([chamberId, slug])
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  logoPath  String?
  createdAt DateTime @default(now())

  products Product[]
}

/// Ana ürün kataloğu — tekil ürün tanımı (karşılaştırmanın temeli)
model Product {
  id          String        @id @default(cuid())
  chamberId   String
  name        String
  slug        String
  barcode     String?
  brandId     String
  categoryId  String
  unitType    UnitType      @default(ADET)
  unitAmount  Decimal?      @db.Decimal(10, 3)
  description String?
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  chamber   Chamber           @relation(fields: [chamberId], references: [id])
  brand     Brand             @relation(fields: [brandId], references: [id])
  category  Category          @relation(fields: [categoryId], references: [id])
  images    ProductImage[]
  offers    SupplierProduct[]
  favorites Favorite[]

  @@unique([chamberId, slug])
  @@unique([chamberId, barcode])
  @@index([categoryId])
  @@index([brandId])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  path      String
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductRequest {
  id           String        @id @default(cuid())
  chamberId    String
  supplierId   String
  name         String
  barcode      String?
  brandName    String
  categoryId   String?
  unitType     UnitType      @default(ADET)
  unitAmount   Decimal?      @db.Decimal(10, 3)
  description  String?
  imagePath    String?
  status       RequestStatus @default(PENDING)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  productId    String?
  createdAt    DateTime      @default(now())

  chamber  Chamber  @relation(fields: [chamberId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

/// Tedarikçi teklifi: belirli bir ürünü hangi paketle, hangi fiyatla sattığı
model SupplierProduct {
  id             String   @id @default(cuid())
  supplierId     String
  productId      String
  sku            String?
  packType       PackType @default(KOLI)
  unitsPerPack   Int      @default(1)
  /// KDV hariç birim (adet/kg) fiyatı
  unitPrice      Decimal  @db.Decimal(12, 2)
  /// KDV hariç paket (koli) fiyatı — sipariş bu fiyat üzerinden verilir
  packPrice      Decimal  @db.Decimal(12, 2)
  vatRate        Int      @default(20)
  minOrderQty    Decimal  @default(1) @db.Decimal(10, 3)
  orderStep      Decimal  @default(1) @db.Decimal(10, 3)
  active         Boolean  @default(true)
  removedByAdmin Boolean  @default(false)
  removalReason  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  supplier        Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product         Product             @relation(fields: [productId], references: [id])
  prices          ProductPrice[]
  stock           Stock?
  stockMovements  StockMovement[]
  discounts       Discount[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  sponsored       SponsoredProduct[]
  catalogItems    CatalogItem[]

  @@unique([supplierId, productId, packType])
  @@index([productId])
}

/// Fiyat geçmişi ve Odaya özel fiyat
model ProductPrice {
  id                String    @id @default(cuid())
  supplierProductId String
  type              PriceType
  packPrice         Decimal   @db.Decimal(12, 2)
  validFrom         DateTime  @default(now())
  validTo           DateTime?
  createdById       String?
  createdAt         DateTime  @default(now())

  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)

  @@index([supplierProductId, type])
}

model Stock {
  supplierProductId String   @id
  quantity          Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt         DateTime @updatedAt

  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
}

model StockMovement {
  id                String      @id @default(cuid())
  supplierProductId String
  change            Decimal     @db.Decimal(12, 3)
  reason            StockReason
  reference         String?
  userId            String?
  createdAt         DateTime    @default(now())

  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)

  @@index([supplierProductId, createdAt])
}

model Favorite {
  memberId  String
  productId String
  createdAt DateTime @default(now())

  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([memberId, productId])
}

// ───────────────────────── Kampanya ─────────────────────────

model Campaign {
  id           String         @id @default(cuid())
  chamberId    String
  supplierId   String
  title        String
  description  String?
  imagePath    String?
  type         CampaignType
  membersOnly  Boolean        @default(true)
  startsAt     DateTime
  endsAt       DateTime
  status       CampaignStatus @default(DRAFT)
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  featured     Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  chamber    Chamber     @relation(fields: [chamberId], references: [id])
  supplier   Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  discounts  Discount[]
  orderItems OrderItem[]

  @@index([status, startsAt, endsAt])
}

/// Kademeli indirim: minQty ve üzeri pakette uygulanır
model Discount {
  id                String       @id @default(cuid())
  campaignId        String
  supplierProductId String
  kind              DiscountKind
  value             Decimal      @db.Decimal(12, 2)
  minQty            Decimal      @default(1) @db.Decimal(10, 3)

  campaign        Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Sepet ve sipariş ─────────────────────────

model Cart {
  id        String   @id @default(cuid())
  memberId  String   @unique
  updatedAt DateTime @updatedAt

  member Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  items  CartItem[]
}

model CartItem {
  id                String   @id @default(cuid())
  cartId            String
  supplierProductId String
  quantity          Decimal  @db.Decimal(10, 3)
  seenPackPrice     Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now())

  cart            Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)

  @@unique([cartId, supplierProductId])
}

/// Üyenin tek seferde verdiği ana sipariş
model Order {
  id              String   @id @default(cuid())
  orderNumber     String   @unique
  chamberId       String
  memberId        String
  createdById     String
  idempotencyKey  String   @unique
  addressSnapshot Json
  note            String?
  subtotal        Decimal  @db.Decimal(12, 2)
  discountTotal   Decimal  @db.Decimal(12, 2)
  vatTotal        Decimal  @db.Decimal(12, 2)
  grandTotal      Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  chamber        Chamber         @relation(fields: [chamberId], references: [id])
  member         Member          @relation(fields: [memberId], references: [id])
  createdBy      User            @relation("OrderCreatedBy", fields: [createdById], references: [id])
  supplierOrders SupplierOrder[]

  @@index([memberId, createdAt])
}

/// Tedarikçiye iletilen alt sipariş
model SupplierOrder {
  id             String              @id @default(cuid())
  orderId        String
  supplierId     String
  subNumber      String              @unique
  status         SupplierOrderStatus @default(PENDING)
  subtotal       Decimal             @db.Decimal(12, 2)
  discountTotal  Decimal             @db.Decimal(12, 2)
  vatTotal       Decimal             @db.Decimal(12, 2)
  grandTotal     Decimal             @db.Decimal(12, 2)
  plannedDate    DateTime?
  rejectReason   String?
  supplierNote   String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  order         Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier      Supplier             @relation(fields: [supplierId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  invoices      Invoice[]
  payments      Payment[]

  @@index([supplierId, status, createdAt])
}

/// Sipariş satırı — ürün ve fiyat bilgisi anlık kopya olarak saklanır
model OrderItem {
  id                String   @id @default(cuid())
  supplierOrderId   String
  supplierProductId String
  productName       String
  brandName         String
  barcode           String?
  packType          PackType
  unitsPerPack      Int
  quantity          Decimal  @db.Decimal(10, 3)
  listPackPrice     Decimal  @db.Decimal(12, 2)
  finalPackPrice    Decimal  @db.Decimal(12, 2)
  vatRate           Int
  lineSubtotal      Decimal  @db.Decimal(12, 2)
  lineDiscount      Decimal  @db.Decimal(12, 2)
  lineVat           Decimal  @db.Decimal(12, 2)
  lineTotal         Decimal  @db.Decimal(12, 2)
  campaignId        String?

  supplierOrder   SupplierOrder   @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id])
  campaign        Campaign?       @relation(fields: [campaignId], references: [id])
}

model OrderStatusHistory {
  id              String               @id @default(cuid())
  supplierOrderId String
  fromStatus      SupplierOrderStatus?
  toStatus        SupplierOrderStatus
  changedById     String?
  note            String?
  createdAt       DateTime             @default(now())

  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
  changedBy     User?         @relation(fields: [changedById], references: [id])
}

/// Tedarikçinin kestiği fatura/irsaliyenin kaydı (Oda belge kesmez)
model Invoice {
  id              String      @id @default(cuid())
  supplierOrderId String
  type            InvoiceType
  documentNumber  String
  documentDate    DateTime
  amount          Decimal?    @db.Decimal(12, 2)
  filePath        String?
  createdAt       DateTime    @default(now())

  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
}

/// İleride ödeme entegrasyonu için altyapı. Şu an yalnızca OFFLINE.
model Payment {
  id              String        @id @default(cuid())
  supplierOrderId String
  method          PaymentMethod @default(OFFLINE)
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  reference       String?
  createdAt       DateTime      @default(now())

  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Gelir modeli (Dalga 2) ─────────────────────────

model SupplierPackage {
  id               String      @id @default(cuid())
  chamberId        String
  name             String
  type             PackageType
  description      String?
  productLimit     Int?
  sponsoredSlots   Int         @default(0)
  bannerSlots      Int         @default(0)
  price            Decimal     @db.Decimal(12, 2)
  durationDays     Int
  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  chamber       Chamber                @relation(fields: [chamberId], references: [id])
  subscriptions SupplierSubscription[]
}

model SupplierSubscription {
  id         String             @id @default(cuid())
  supplierId String
  packageId  String
  startsAt   DateTime
  endsAt     DateTime
  status     SubscriptionStatus @default(PENDING)
  pricePaid  Decimal            @db.Decimal(12, 2)
  note       String?
  createdAt  DateTime           @default(now())

  supplier Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  package  SupplierPackage @relation(fields: [packageId], references: [id])
}

model AdSlot {
  id          String  @id @default(cuid())
  chamberId   String
  code        String
  name        String
  width       Int
  height      Int
  active      Boolean @default(true)

  chamber        Chamber         @relation(fields: [chamberId], references: [id])
  advertisements Advertisement[]

  @@unique([chamberId, code])
}

model Advertisement {
  id          String   @id @default(cuid())
  slotId      String
  supplierId  String?
  title       String
  imagePath   String
  targetUrl   String?
  startsAt    DateTime
  endsAt      DateTime
  status      AdStatus @default(PENDING)
  fee         Decimal? @db.Decimal(12, 2)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  createdAt   DateTime @default(now())

  slot     AdSlot    @relation(fields: [slotId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
}

model SponsoredProduct {
  id                String   @id @default(cuid())
  supplierProductId String
  startsAt          DateTime
  endsAt            DateTime
  sortOrder         Int      @default(0)
  fee               Decimal? @db.Decimal(12, 2)
  active            Boolean  @default(true)

  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
}

model Catalog {
  id          String   @id @default(cuid())
  supplierId  String
  categoryId  String?
  title       String
  coverPath   String?
  filePath    String?
  startsAt    DateTime
  endsAt      DateTime?
  status      AdStatus @default(PENDING)
  createdAt   DateTime @default(now())

  supplier Supplier      @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  category Category?     @relation(fields: [categoryId], references: [id])
  items    CatalogItem[]
}

model CatalogItem {
  catalogId         String
  supplierProductId String
  sortOrder         Int    @default(0)

  catalog         Catalog         @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  supplierProduct SupplierProduct @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)

  @@id([catalogId, supplierProductId])
}

// ───────────────────────── Sistem ─────────────────────────

model Announcement {
  id          String               @id @default(cuid())
  chamberId   String
  title       String
  body        String
  audience    AnnouncementAudience @default(ALL)
  pinned      Boolean              @default(false)
  publishedAt DateTime             @default(now())
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime             @default(now())

  chamber Chamber @relation(fields: [chamberId], references: [id])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  channel   NotificationChannel @default(IN_APP)
  delivery  DeliveryState       @default(PENDING)
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

/// Yalnızca eklenebilir denetim kaydı (uygulama UPDATE/DELETE yapmaz)
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  data       Json?
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model LegalDocument {
  id          String       @id @default(cuid())
  chamberId   String
  type        LegalDocType
  version     String
  title       String
  body        String
  effectiveAt DateTime
  createdAt   DateTime     @default(now())

  chamber  Chamber         @relation(fields: [chamberId], references: [id])
  consents ConsentRecord[]

  @@unique([chamberId, type, version])
}

model ConsentRecord {
  id         String   @id @default(cuid())
  userId     String
  documentId String
  ip         String?
  createdAt  DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  document LegalDocument @relation(fields: [documentId], references: [id])

  @@unique([userId, documentId])
}

model OrderSequence {
  year  Int @id
  value Int @default(0)
}
